# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is ignored by Git, so your secrets are never uploaded to GitHub.

DB_URL=jdbc:mysql://localhost:3306/hotel_booking?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=hotel_user
DB_PASSWORD=your_mysql_password_here

# Must be at least 32 characters. Generate one with:
#   PowerShell: [Convert]::ToBase64String((1..48 | % { Get-Random -Maximum 256 }) -as [byte[]])
JWT_SECRET=replace_with_a_long_random_secret_of_at_least_32_chars
JWT_EXPIRATION_MS=86400000

# The URL(s) of your frontend, comma-separated (no trailing slash)
CORS_ALLOWED_ORIGINS=http://localhost:5173
